{%- liquid
  assign ink = '#121212'
  assign brand = section.settings.brand_color | default: '#178a3f'
  assign highlight = section.settings.highlight_color | default: '#d8f3dd'

  assign script_value = section.settings.script_font | default: 'Yellowtail'
  assign script_family = script_value | replace: '+', ' '
  assign script_scale = section.settings.script_scale | divided_by: 100.0

  assign heading_plain = section.settings.heading | strip_html
  if heading_plain == blank
    assign heading_plain = 'Customer video'
  endif
-%}

{%- if section.settings.load_script_font -%}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ script_value }}&amp;display=swap">
{%- endif -%}

<div class="ugc-section" id="ugc-{{ section.id }}">
  <div class="ugc-head">
    {%- if section.settings.heading != blank -%}
      <h2 class="ugc-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ugc-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="ugc-viewport" data-ugc-viewport>
    <button class="ugc-nav ugc-prev" type="button" aria-label="Previous" data-ugc-prev>
      <svg viewBox="0 0 24 24" width="22" height="22"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="ugc-track" data-ugc-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          {%- liquid
            assign has_video = false
            if block.settings.video != blank
              assign has_video = true
            endif
            assign poster = block.settings.image
            if poster == blank and block.settings.video != blank
              assign poster = block.settings.video.preview_image
            endif
            assign poster_alt = poster.alt
            if poster_alt == blank
              assign poster_alt = heading_plain
            endif
          -%}
          <div class="ugc-slide" data-ugc-slide {{ block.shopify_attributes }}>
            <div class="ugc-card">
              {%- if has_video -%}
                <video
                  class="ugc-video"
                  data-ugc-video
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  {% if poster != blank %}poster="{{ poster | image_url: width: 720 }}"{% endif %}
                >
                  {%- for source in block.settings.video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
                <button class="ugc-playbtn" type="button" aria-label="Play video" data-ugc-play>
                  <svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                </button>
                <button class="ugc-mutebtn" type="button" aria-label="Toggle sound" data-ugc-mute>
                  <svg class="ugc-ico-muted" viewBox="0 0 24 24" width="18" height="18"><path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/><path d="M16 8l5 8M21 8l-5 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  <svg class="ugc-ico-on" viewBox="0 0 24 24" width="18" height="18"><path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/><path d="M16.5 8.5a5 5 0 010 7M19 6a8 8 0 010 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
                </button>
              {%- elsif poster != blank -%}
                {{
                  poster
                  | image_url: width: 720
                  | image_tag:
                    loading: 'lazy',
                    class: 'ugc-img',
                    widths: '300, 450, 600, 720',
                    sizes: '(min-width: 750px) 360px, 78vw',
                    alt: poster_alt
                }}
              {%- else -%}
                <div class="ugc-placeholder">{{ 'image' | placeholder_svg_tag: 'ugc-placeholder-svg' }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <button class="ugc-nav ugc-next" type="button" aria-label="Next" data-ugc-next>
      <svg viewBox="0 0 24 24" width="22" height="22"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <div class="ugc-dots" data-ugc-dots></div>
</div>

<style>
  #ugc-{{ section.id }} {
    --ugc-brand: {{ brand }};
    --ugc-highlight: {{ highlight }};
    --ugc-script: '{{ script_family }}', 'Brush Script MT', cursive;
    --ugc-script-scale: {{ script_scale }};
    --ugc-slide-w: {{ section.settings.slide_width | default: 360 }}px;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_bg | default: '#ffffff' }};
    overflow: hidden;
  }
  #ugc-{{ section.id }} .ugc-head { text-align: center; padding: 0 16px; margin-bottom: 28px; }
  #ugc-{{ section.id }} .ugc-heading {
    margin: 0 0 10px;
    font-size: 44px;
    font-weight: 800;
    line-height: 1.3;
    color: {{ ink }};
  }

  /* The handwritten accent. Words italicised in the theme editor come through
     as <em>, so the merchant never has to touch markup. font-style is reset to
     normal because the em is only being borrowed as a marker. */
  #ugc-{{ section.id }} .ugc-heading em {
    font-family: var(--ugc-script);
    font-style: normal;
    font-weight: 400;
    font-size: calc(1em * var(--ugc-script-scale));
    line-height: 0.85;
    color: var(--ugc-brand);
  }

  #ugc-{{ section.id }} .ugc-subheading {
    max-width: 760px;
    margin: 0 auto;
    font-size: 17px;
    line-height: 1.5;
    color: #5b5b5b;
  }
  #ugc-{{ section.id }} .ugc-subheading strong { font-weight: 700; color: {{ ink }}; }
  #ugc-{{ section.id }} .ugc-subheading em {
    font-style: normal;
    font-weight: 700;
    color: var(--ugc-brand);
    background: var(--ugc-highlight);
    padding: 0 5px;
    border-radius: 3px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  #ugc-{{ section.id }} .ugc-viewport { position: relative; width: 100%; }

  #ugc-{{ section.id }} .ugc-track {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 20px 0;
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  #ugc-{{ section.id }} .ugc-video,
  #ugc-{{ section.id }} .ugc-img {
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }
  #ugc-{{ section.id }} .ugc-track.is-dragging { transition: none; cursor: grabbing; }

  #ugc-{{ section.id }} .ugc-slide {
    flex: 0 0 var(--ugc-slide-w);
    width: var(--ugc-slide-w);
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.5s ease;
    transform: scale(0.8);
    opacity: 0.45;
  }
  #ugc-{{ section.id }} .ugc-slide.is-active { transform: scale(1); opacity: 1; }

  #ugc-{{ section.id }} .ugc-card {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 14px;
    overflow: hidden;
    background: #ececec;
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }
  #ugc-{{ section.id }} .ugc-video,
  #ugc-{{ section.id }} .ugc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #ugc-{{ section.id }} .ugc-placeholder { width: 100%; height: 100%; }
  #ugc-{{ section.id }} .ugc-placeholder svg { width: 100%; height: 100%; object-fit: cover; opacity: 0.4; }

  /* Controls — only shown on the active slide */
  #ugc-{{ section.id }} .ugc-playbtn,
  #ugc-{{ section.id }} .ugc-mutebtn {
    position: absolute;
    border: 0;
    cursor: pointer;
    color: #fff;
    display: none;
    align-items: center;
    justify-content: center;
  }
  #ugc-{{ section.id }} .ugc-slide.is-active .ugc-mutebtn { display: inline-flex; }
  #ugc-{{ section.id }} .ugc-playbtn {
    inset: 0;
    margin: auto;
    width: 62px;
    height: 62px;
    border-radius: 999px;
    background: rgba(255,255,255,0.28);
    backdrop-filter: blur(2px);
    color: #fff;
  }
  #ugc-{{ section.id }} .ugc-slide.is-active .ugc-card.is-paused .ugc-playbtn { display: inline-flex; }
  #ugc-{{ section.id }} .ugc-playbtn svg { margin-left: 3px; }
  #ugc-{{ section.id }} .ugc-mutebtn {
    right: 12px;
    bottom: 12px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: rgba(0,0,0,0.5);
  }
  #ugc-{{ section.id }} .ugc-mutebtn .ugc-ico-on { display: none; }
  #ugc-{{ section.id }} .ugc-card.is-unmuted .ugc-ico-muted { display: none; }
  #ugc-{{ section.id }} .ugc-card.is-unmuted .ugc-ico-on { display: block; }

  /* Arrows */
  #ugc-{{ section.id }} .ugc-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid #e3e3e3;
    background: #fff;
    color: {{ ink }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    transition: transform 0.15s ease, opacity 0.2s ease;
  }
  #ugc-{{ section.id }} .ugc-nav:hover { transform: translateY(-50%) scale(1.06); }
  #ugc-{{ section.id }} .ugc-nav:disabled { opacity: 0.35; cursor: default; }
  #ugc-{{ section.id }} .ugc-prev { left: 16px; }
  #ugc-{{ section.id }} .ugc-next { right: 16px; }

  /* Dots */
  #ugc-{{ section.id }} .ugc-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }
  #ugc-{{ section.id }} .ugc-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: #d5d5d5;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  #ugc-{{ section.id }} .ugc-dot.is-active { background: {{ ink }}; transform: scale(1.15); }

  @media (max-width: 990px) {
    #ugc-{{ section.id }} { --ugc-slide-w: 300px; }
    #ugc-{{ section.id }} .ugc-heading { font-size: 34px; }
    #ugc-{{ section.id }} .ugc-subheading { font-size: 15px; }
  }
  @media (max-width: 749px) {
    #ugc-{{ section.id }} { --ugc-slide-w: 74vw; }
    #ugc-{{ section.id }} .ugc-track { gap: 14px; }
    #ugc-{{ section.id }} .ugc-heading { font-size: 27px; }
    #ugc-{{ section.id }} .ugc-nav { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #ugc-{{ section.id }} .ugc-track,
    #ugc-{{ section.id }} .ugc-slide { transition: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('ugc-{{ section.id }}');
    if (!root || root.dataset.ugcInit === '1') return;
    root.dataset.ugcInit = '1';

    var track = root.querySelector('[data-ugc-track]');
    var viewport = root.querySelector('[data-ugc-viewport]');
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-ugc-slide]'));
    var dotsWrap = root.querySelector('[data-ugc-dots]');
    var prevBtn = root.querySelector('[data-ugc-prev]');
    var nextBtn = root.querySelector('[data-ugc-next]');
    var autoplayActive = {{ section.settings.autoplay_active | default: true }};
    if (!track || slides.length === 0) return;

    var index = Math.floor(slides.length / 2);

    // Build dots
    var dots = [];
    slides.forEach(function (_, i) {
      var d = document.createElement('button');
      d.type = 'button';
      d.className = 'ugc-dot';
      d.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      d.addEventListener('click', function () { go(i); });
      dotsWrap.appendChild(d);
      dots.push(d);
    });

    function centerTo(i, animate) {
      var slide = slides[i];
      var offset = slide.offsetLeft + slide.offsetWidth / 2 - viewport.clientWidth / 2;
      if (animate === false) {
        track.style.transition = 'none';
        track.style.transform = 'translateX(' + (-offset) + 'px)';
        void track.offsetWidth; // reflow
        track.style.transition = '';
      } else {
        track.style.transform = 'translateX(' + (-offset) + 'px)';
      }
    }

    function updateMedia() {
      slides.forEach(function (slide, i) {
        var video = slide.querySelector('[data-ugc-video]');
        var card = slide.querySelector('.ugc-card');
        if (!video) return;
        if (i === index) {
          if (autoplayActive) {
            var p = video.play();
            if (p && p.catch) { p.catch(function () { if (card) card.classList.add('is-paused'); }); }
            if (card) card.classList.remove('is-paused');
          }
        } else {
          video.pause();
          video.currentTime = 0;
          video.muted = true;
          if (card) card.classList.remove('is-unmuted');
        }
      });
    }

    function go(i) {
      index = Math.max(0, Math.min(slides.length - 1, i));
      slides.forEach(function (s, j) { s.classList.toggle('is-active', j === index); });
      dots.forEach(function (d, j) { d.classList.toggle('is-active', j === index); });
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === slides.length - 1;
      centerTo(index, true);
      updateMedia();
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { go(index - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { go(index + 1); });

    // Click a side slide to focus it
    slides.forEach(function (slide, i) {
      slide.addEventListener('click', function (e) {
        if (i !== index && !e.target.closest('[data-ugc-mute], [data-ugc-play]')) { go(i); }
      });
    });

    // Per-slide video controls
    slides.forEach(function (slide) {
      var video = slide.querySelector('[data-ugc-video]');
      var card = slide.querySelector('.ugc-card');
      var muteBtn = slide.querySelector('[data-ugc-mute]');
      var playBtn = slide.querySelector('[data-ugc-play]');
      if (!video) return;
      if (muteBtn) muteBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        video.muted = !video.muted;
        card.classList.toggle('is-unmuted', !video.muted);
        if (video.paused) video.play();
      });
      if (playBtn) playBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        video.play();
        card.classList.remove('is-paused');
      });
      video.addEventListener('pause', function () { card.classList.add('is-paused'); });
      video.addEventListener('play', function () { card.classList.remove('is-paused'); });
    });

    // Drag / swipe
    var startX = 0, dragging = false, moved = 0;
    function onDown(x) { dragging = true; startX = x; moved = 0; track.classList.add('is-dragging'); }
    function onMove(x) {
      if (!dragging) return;
      moved = x - startX;
      var slide = slides[index];
      var base = slide.offsetLeft + slide.offsetWidth / 2 - viewport.clientWidth / 2;
      track.style.transform = 'translateX(' + (-base + moved) + 'px)';
    }
    function onUp() {
      if (!dragging) return;
      dragging = false;
      track.classList.remove('is-dragging');
      if (Math.abs(moved) > 50) { go(index + (moved < 0 ? 1 : -1)); }
      else { centerTo(index, true); }
    }
    track.addEventListener('mousedown', function (e) { e.preventDefault(); onDown(e.clientX); });
    track.addEventListener('dragstart', function (e) { e.preventDefault(); });
    window.addEventListener('mousemove', function (e) { onMove(e.clientX); });
    window.addEventListener('mouseup', onUp);
    track.addEventListener('touchstart', function (e) { onDown(e.touches[0].clientX); }, { passive: true });
    track.addEventListener('touchmove', function (e) { onMove(e.touches[0].clientX); }, { passive: true });
    track.addEventListener('touchend', onUp);

    // Prevent click-navigation right after a drag
    track.addEventListener('click', function (e) { if (Math.abs(moved) > 5) e.stopPropagation(); }, true);

    window.addEventListener('resize', function () { centerTo(index, false); });

    // Init after layout/fonts settle
    function init() { go(index); centerTo(index, false); }
    if (document.readyState === 'complete') { init(); }
    else { window.addEventListener('load', init); setTimeout(init, 300); }

    // The handwritten font arrives after first paint and changes the heading
    // height, which shifts every slide's offsetLeft. Re-centre once it lands.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () { centerTo(index, false); });
    }

    // Shopify theme editor support
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') { centerTo(index, false); }
    });
  })();
</script>

{% schema %}
{
  "name": "UGC — real world",
  "tag": "section",
  "class": "ugc-real-world-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Select a word and press italic to give it the handwritten accent font.",
      "default": "<em>Real</em> Moments, <em>Real</em> Love!"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "info": "Bold reads as normal bold text. Italic gets the accent colour and the highlight behind it.",
      "default": "Real families, real unboxings — every clip below was sent in by someone who ordered a <strong><em>Woolly Wishes</em></strong> keepsake."
    },
    {
      "type": "header",
      "content": "Accent font"
    },
    {
      "type": "checkbox",
      "id": "load_script_font",
      "label": "Load the handwritten font",
      "info": "Turn off to use your theme font instead. Adds one request to Google Fonts.",
      "default": true
    },
    {
      "type": "select",
      "id": "script_font",
      "label": "Handwritten font",
      "options": [
        { "value": "Yellowtail", "label": "Yellowtail — closest to the reference" },
        { "value": "Pacifico", "label": "Pacifico — rounder, friendlier" },
        { "value": "Kaushan+Script", "label": "Kaushan Script — brush, more slanted" },
        { "value": "Satisfy", "label": "Satisfy — lighter, flowing" },
        { "value": "Courgette", "label": "Courgette — tidy, less swash" }
      ],
      "default": "Yellowtail"
    },
    {
      "type": "range",
      "id": "script_scale",
      "label": "Accent font size",
      "info": "Handwritten fonts read smaller than block letters at the same size, so they usually need a nudge up.",
      "min": 100,
      "max": 150,
      "step": 2,
      "unit": "%",
      "default": 118
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Accent color",
      "info": "Used for the handwritten words and the highlighted text.",
      "default": "#178a3f"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight behind accent text",
      "default": "#d8f3dd"
    },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    {
      "type": "header",
      "content": "Carousel"
    },
    { "type": "checkbox", "id": "autoplay_active", "label": "Auto-play center video (muted)", "default": true },
    { "type": "range", "id": "slide_width", "min": 260, "max": 460, "step": 10, "unit": "px", "label": "Slide width (desktop)", "default": 360 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide (video / image)",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (vertical 9:16 best)" },
        { "type": "image_picker", "id": "image", "label": "Image / video poster", "info": "Used as the slide if no video, or as the video's poster." }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC — real world",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
