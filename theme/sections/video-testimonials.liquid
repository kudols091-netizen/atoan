{%- liquid
  assign script_value = section.settings.script_font | default: 'Yellowtail'
  assign script_family = script_value | replace: '+', ' '
  assign script_scale = section.settings.script_scale | divided_by: 100.0
-%}

{%- if section.settings.load_script_font -%}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ script_value }}&amp;display=swap">
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --vt-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --vt-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --vt-accent: {{ section.settings.accent_color | default: '#178a3f' }};
    --vt-highlight: {{ section.settings.highlight_color | default: '#d8f3dd' }};
    --vt-script: '{{ script_family }}', 'Brush Script MT', cursive;
    --vt-script-scale: {{ script_scale }};
    --vt-cols: {{ section.settings.visible_desktop | default: '4.75' }};
    --vt-gap: 22px;
    --vt-dim: {{ section.settings.side_opacity | divided_by: 100.0 }};
    --vt-shrink: {{ section.settings.side_scale | divided_by: 100.0 }};
    --vt-radius: {{ section.settings.card_radius }}px;
    --vt-pad-top: {{ section.settings.padding_top }}px;
    --vt-pad-bottom: {{ section.settings.padding_bottom }}px;
  }

  .vt {
    background: var(--vt-bg);
    color: var(--vt-text);
    padding-top: calc(var(--vt-pad-top) * 0.7);
    padding-bottom: calc(var(--vt-pad-bottom) * 0.7);
  }

  .vt__inner {
    max-width: 1760px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ---------- headings ---------- */

  .vt__heading {
    margin: 0 0 10px;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    color: inherit;
  }

  /* The script look: words italicised in the theme editor become the accent. */
  .vt__heading em {
    font-family: var(--vt-script);
    font-style: normal;
    font-weight: 400;
    font-size: calc(1em * var(--vt-script-scale));
    line-height: 0.85;
    color: var(--vt-accent);
  }

  .vt__sub {
    max-width: 760px;
    margin: 0 auto;
    font-size: 16px;
    line-height: 1.5;
    text-align: center;
    color: inherit;
  }

  .vt__sub strong { font-weight: 700; }

  .vt__sub em {
    font-style: normal;
    color: var(--vt-accent);
    background: var(--vt-highlight);
    padding: 0 5px;
    border-radius: 3px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* ---------- carousel ---------- */

  .vt__wrap {
    position: relative;
    margin-top: 30px;
  }

  .vt__viewport {
    overflow: hidden;
    --vt-visible: 1.7;
  }

  .vt__viewport:focus-visible { outline: 2px solid var(--vt-accent); outline-offset: 4px; }

  .vt__track {
    display: flex;
    gap: var(--vt-gap);
    align-items: center;
    transition: transform 480ms cubic-bezier(0.33, 0, 0.2, 1);
    touch-action: pan-y;
    will-change: transform;
  }

  .vt__track.is-instant { transition: none; }

  .vt__slide {
    flex: 0 0 calc((100% - (var(--vt-visible) - 1) * var(--vt-gap)) / var(--vt-visible));
    min-width: 0;
  }

  /* Everything but the centre sits back: smaller and faded, so there is only
     ever one place for the eye to land. */
  .vt__card {
    position: relative;
    overflow: hidden;
    border-radius: var(--vt-radius);
    background: #e9e6e2;
    aspect-ratio: 9 / 16;
    transform: scale(var(--vt-shrink));
    opacity: var(--vt-dim);
    transition: transform 480ms cubic-bezier(0.33, 0, 0.2, 1), opacity 480ms ease, box-shadow 480ms ease;
  }

  .vt__slide.is-active .vt__card {
    transform: scale(1);
    opacity: 1;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.18);
  }

  .vt__card video,
  .vt__card img,
  .vt__card svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vt__poster {
    position: absolute;
    inset: 0;
    transition: opacity 250ms ease;
  }

  .vt__card.is-started .vt__poster {
    opacity: 0;
    pointer-events: none;
  }

  .vt__pick {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .vt__pick:focus-visible { outline: 2px solid var(--vt-accent); outline-offset: -4px; }

  /* Only the centre clip is playing, so only it gets controls. */
  .vt__tools {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 3;
    display: flex;
    gap: 8px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms ease;
  }

  .vt__slide.is-active .vt__tools { opacity: 1; pointer-events: auto; }

  .vt__tool {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
    cursor: pointer;
  }

  .vt__tool:hover { background: rgba(0, 0, 0, 0.72); }
  .vt__tool:focus-visible { outline: 2px solid #ffffff; outline-offset: 2px; }
  .vt__tool svg { display: block; width: 14px; height: 14px; }

  .vt__icon { display: none; }
  .vt__card.is-muted .vt__icon--muted { display: block; }
  .vt__card:not(.is-muted) .vt__icon--sound { display: block; }
  .vt__card.is-held .vt__icon--resume { display: block; }
  .vt__card:not(.is-held) .vt__icon--hold { display: block; }

  .vt__nav {
    position: absolute;
    top: 50%;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-top: -18px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ffffff;
    color: #111111;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.16);
    cursor: pointer;
  }

  .vt__nav svg { display: block; width: 15px; height: 15px; }
  .vt__nav--prev { left: 4px; }
  .vt__nav--next { right: 4px; }
  .vt--static .vt__nav { display: none; }

  .vt__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 22px;
  }

  .vt--static .vt__dots { display: none; }

  .vt__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.22;
    cursor: pointer;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .vt__dot.is-active { opacity: 1; transform: scale(1.25); }
  .vt__dot:focus-visible { outline: 2px solid var(--vt-accent); outline-offset: 3px; }

  /* ---------- breakpoints ---------- */

  @media screen and (min-width: 750px) {
    .vt__viewport { --vt-visible: 2.8; }
    .vt__heading { font-size: 38px; }
    .vt__nav { width: 42px; height: 42px; margin-top: -21px; }
    .vt__nav svg { width: 17px; height: 17px; }
  }

  @media screen and (min-width: 990px) {
    .vt {
      padding-top: var(--vt-pad-top);
      padding-bottom: var(--vt-pad-bottom);
    }

    .vt__viewport { --vt-visible: var(--vt-cols); }
    .vt__heading { font-size: 46px; margin-bottom: 14px; }
    .vt__sub { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vt__track,
    .vt__card { transition: none; }
  }
{%- endstyle -%}

<div class="vt" id="VtStrip-{{ section.id }}" data-vt-root data-vt-advance="{{ section.settings.advance_on_end }}" data-vt-autoplay="{{ section.settings.autoplay }}">
  <div class="vt__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="vt__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="vt__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="vt__wrap">
      <div
        class="vt__viewport"
        data-vt-viewport
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label="{{ 'Customer videos' | escape }}"
      >
        <div class="vt__track" data-vt-track>
          {%- for block in section.blocks -%}
            <div class="vt__slide" data-vt-slide {{ block.shopify_attributes }}>
              <div class="vt__card is-muted" data-vt-card>
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '720x',
                      muted: true,
                      preload: 'none'
                  }}

                  {%- if block.settings.poster != blank -%}
                    {%- assign poster_alt = block.settings.poster.alt -%}
                    {%- if poster_alt == blank -%}
                      {%- assign poster_alt = 'A customer unboxing their handmade crochet gift' -%}
                    {%- endif -%}
                    {{
                      block.settings.poster
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        class: 'vt__poster',
                        widths: '240, 360, 480, 640, 800',
                        sizes: '(min-width: 990px) 360px, 60vw',
                        alt: poster_alt
                    }}
                  {%- endif -%}

                  <button
                    type="button"
                    class="vt__pick"
                    data-vt-pick
                    aria-label="{{ 'Bring this video to the centre' | escape }}"
                  ></button>

                  <div class="vt__tools">
                    <button type="button" class="vt__tool" data-vt-hold aria-label="{{ 'Pause this video' | escape }}">
                      <svg class="vt__icon vt__icon--hold" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true" focusable="false">
                        <rect x="2.5" y="1.5" width="3.4" height="11" rx="0.9"/>
                        <rect x="8.1" y="1.5" width="3.4" height="11" rx="0.9"/>
                      </svg>
                      <svg class="vt__icon vt__icon--resume" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M3 1.4l9 5.6-9 5.6z"/>
                      </svg>
                    </button>

                    <button type="button" class="vt__tool" data-vt-sound aria-label="{{ 'Turn on sound' | escape }}">
                      <svg class="vt__icon vt__icon--muted" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                        <path d="M6.4 2.2L3.9 4.4H2v5.2h1.9l2.5 2.2z" fill="currentColor"/>
                        <path d="M9.2 5.2l3 3.6M12.2 5.2l-3 3.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                      </svg>
                      <svg class="vt__icon vt__icon--sound" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                        <path d="M6.4 2.2L3.9 4.4H2v5.2h1.9l2.5 2.2z" fill="currentColor"/>
                        <path d="M9.1 5.1a2.7 2.7 0 010 3.8M11 3.2a5.3 5.3 0 010 7.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <button type="button" class="vt__nav vt__nav--prev" data-vt-prev aria-label="{{ 'Previous video' | escape }}">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
          <path d="M10.5 2 4.5 8l6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button type="button" class="vt__nav vt__nav--next" data-vt-next aria-label="{{ 'Next video' | escape }}">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
          <path d="M5.5 2l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <div class="vt__dots" data-vt-dots></div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('VtStrip-{{ section.id }}');
    if (!root || root.dataset.vtInit === 'true') return;
    root.dataset.vtInit = 'true';

    var viewport = root.querySelector('[data-vt-viewport]');
    var track = root.querySelector('[data-vt-track]');
    var dotsBox = root.querySelector('[data-vt-dots]');
    var prevBtn = root.querySelector('[data-vt-prev]');
    var nextBtn = root.querySelector('[data-vt-next]');
    if (!viewport || !track) return;

    var real = Array.prototype.slice.call(track.querySelectorAll('[data-vt-slide]'));
    var total = real.length;
    if (total === 0) return;

    var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    var connection = navigator.connection || {};
    var wantsAutoplay = root.dataset.vtAutoplay === 'true';
    var advanceOnEnd = root.dataset.vtAdvance === 'true';

    // Someone who asked for less motion, or who is paying per megabyte, gets a
    // still card with a play button instead of a clip that starts by itself.
    function ambientAllowed() {
      return wantsAutoplay && !motionQuery.matches && connection.saveData !== true;
    }

    var soundOn = false;
    var held = false;
    var onScreen = true;
    var enabled = total > 1;

    /* ---------- clones ---------- */

    // Widest layout is 7 visible, so three either side plus one spare.
    var clones = enabled ? Math.min(total, 4) : 0;

    for (var i = 0; i < clones; i++) {
      var tail = real[total - 1 - i].cloneNode(true);
      tail.setAttribute('data-vt-clone', '');
      tail.setAttribute('aria-hidden', 'true');
      track.insertBefore(tail, track.firstChild);

      var head = real[i].cloneNode(true);
      head.setAttribute('data-vt-clone', '');
      head.setAttribute('aria-hidden', 'true');
      track.appendChild(head);
    }

    var slides = Array.prototype.slice.call(track.querySelectorAll('[data-vt-slide]'));
    var pos = clones;

    root.classList.toggle('vt--static', !enabled);

    /* ---------- geometry ---------- */

    function slideWidth() {
      var first = track.children[0];
      return first ? first.getBoundingClientRect().width : 0;
    }

    function pitch() {
      var a = track.children[0];
      var b = track.children[1];
      if (!a) return 0;
      if (!b) return a.getBoundingClientRect().width;
      return b.getBoundingClientRect().left - a.getBoundingClientRect().left;
    }

    // Offset that parks slide `index` dead centre of the viewport.
    function offsetFor(index) {
      return viewport.clientWidth / 2 - (index * pitch() + slideWidth() / 2);
    }

    function realIndex() {
      if (!enabled) return 0;
      return ((pos - clones) % total + total) % total;
    }

    /* ---------- video ---------- */

    function cardOf(slide) { return slide.querySelector('[data-vt-card]'); }
    function videoOf(slide) { return slide.querySelector('video'); }

    function reset(slide) {
      var video = videoOf(slide);
      var card = cardOf(slide);
      if (!video || !card) return;
      if (!video.paused) video.pause();
      video.muted = true;
      card.classList.add('is-muted');
      card.classList.remove('is-held');
    }

    function syncTools(slide) {
      var card = cardOf(slide);
      var video = videoOf(slide);
      if (!card || !video) return;

      card.classList.toggle('is-muted', video.muted);
      card.classList.toggle('is-held', video.paused);

      var soundBtn = slide.querySelector('[data-vt-sound]');
      var holdBtn = slide.querySelector('[data-vt-hold]');
      if (soundBtn) soundBtn.setAttribute('aria-label', video.muted ? 'Turn on sound' : 'Mute');
      if (holdBtn) holdBtn.setAttribute('aria-label', video.paused ? 'Play this video' : 'Pause this video');
    }

    function attemptPlay(slide) {
      var video = videoOf(slide);
      if (!video) return;

      var started = video.play();
      if (!started || typeof started.catch !== 'function') return;

      started.catch(function () {
        // Browsers only grant autoplay to muted video. If an unmuted start was
        // refused, drop to muted and try once more rather than sit frozen.
        if (video.muted) return;
        soundOn = false;
        video.muted = true;
        syncTools(slide);
        var retry = video.play();
        if (retry && typeof retry.catch === 'function') retry.catch(function () {});
      });
    }

    // Runs once the centre slide has finished moving, never mid-slide, so a
    // clone is never the thing that starts playing.
    function settle() {
      slides.forEach(function (slide, index) {
        if (index !== pos) reset(slide);
      });

      var active = slides[pos];
      if (!active) return;

      var video = videoOf(active);
      if (video) {
        video.muted = !soundOn;
        if (onScreen && !held && ambientAllowed()) attemptPlay(active);
        syncTools(active);
      }

      // Buffer the clip that comes next so the hand-off is not a black gap.
      var upcoming = slides[pos + 1];
      if (upcoming) {
        var nextVideo = videoOf(upcoming);
        if (nextVideo && nextVideo.getAttribute('preload') !== 'auto') {
          nextVideo.setAttribute('preload', 'auto');
        }
      }
    }

    /* ---------- movement ---------- */

    function paint(animate) {
      if (!animate) track.classList.add('is-instant');
      track.style.transform = 'translate3d(' + offsetFor(pos) + 'px, 0, 0)';

      slides.forEach(function (slide, index) {
        slide.classList.toggle('is-active', index === pos);
      });

      var current = realIndex();
      if (dotsBox) {
        Array.prototype.forEach.call(dotsBox.children, function (dot, index) {
          dot.classList.toggle('is-active', index === current);
          dot.setAttribute('aria-current', index === current ? 'true' : 'false');
        });
      }

      if (!animate) {
        void track.offsetWidth;
        track.classList.remove('is-instant');
      }
    }

    function go(delta) {
      if (!enabled) return;
      var leaving = slides[pos];
      if (leaving) reset(leaving);
      pos += delta;
      paint(true);
    }

    function jumpTo(index) {
      if (!enabled) return;
      var target = clones + index;
      if (target === pos) return;
      go(target - pos);
    }

    track.addEventListener('transitionend', function (event) {
      if (event.target !== track || event.propertyName !== 'transform') return;

      if (pos >= total + clones) {
        pos -= total;
        paint(false);
      } else if (pos < clones) {
        pos += total;
        paint(false);
      }

      settle();
    });

    /* ---------- dots ---------- */

    if (dotsBox && enabled) {
      real.forEach(function (slide, index) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'vt__dot';
        dot.setAttribute('aria-label', 'Show video ' + (index + 1) + ' of ' + total);
        dot.addEventListener('click', function () { jumpTo(index); });
        dotsBox.appendChild(dot);
      });
    }

    /* ---------- per-card controls ---------- */

    slides.forEach(function (slide, index) {
      var pick = slide.querySelector('[data-vt-pick]');
      var soundBtn = slide.querySelector('[data-vt-sound]');
      var holdBtn = slide.querySelector('[data-vt-hold]');
      var video = videoOf(slide);

      if (video) {
        video.muted = true;
        video.setAttribute('muted', 'muted');

        video.addEventListener('playing', function () {
          var card = cardOf(slide);
          if (card) card.classList.add('is-started');
          syncTools(slide);
        });

        video.addEventListener('pause', function () { syncTools(slide); });

        video.addEventListener('ended', function () {
          if (slides.indexOf(slide) !== pos) return;
          if (advanceOnEnd && enabled && !held) go(1);
        });
      }

      if (pick) {
        pick.addEventListener('click', function () {
          if (viewport.dataset.vtDragged === 'true') return;

          var here = slides.indexOf(slide);
          if (here !== pos) {
            go(here - pos);
            return;
          }

          // Already centred: the card body is the sound toggle.
          if (soundBtn) soundBtn.click();
        });
      }

      if (soundBtn) {
        soundBtn.addEventListener('click', function (event) {
          event.stopPropagation();
          if (!video) return;
          soundOn = video.muted;
          video.muted = !soundOn;
          if (video.paused && !held) attemptPlay(slide);
          syncTools(slide);
        });
      }

      if (holdBtn) {
        holdBtn.addEventListener('click', function (event) {
          event.stopPropagation();
          if (!video) return;
          if (video.paused) {
            held = false;
            attemptPlay(slide);
          } else {
            held = true;
            video.pause();
          }
          syncTools(slide);
        });
      }
    });

    /* ---------- drag / swipe ---------- */

    var drag = null;

    viewport.addEventListener('pointerdown', function (event) {
      if (!enabled) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;

      var span = pitch();
      drag = { id: event.pointerId, x: event.clientX, base: offsetFor(pos), moved: 0, limit: span * 0.9 };
      viewport.dataset.vtDragged = 'false';
      track.classList.add('is-instant');
    });

    viewport.addEventListener('pointermove', function (event) {
      if (drag === null || event.pointerId !== drag.id) return;

      var moved = event.clientX - drag.x;
      if (Math.abs(moved) < 4 && drag.moved === 0) return;

      if (drag.moved === 0) {
        try { viewport.setPointerCapture(drag.id); } catch (e) {}
      }

      if (moved > drag.limit) moved = drag.limit;
      if (moved < -drag.limit) moved = -drag.limit;

      drag.moved = moved;
      viewport.dataset.vtDragged = 'true';
      track.style.transform = 'translate3d(' + (drag.base + moved) + 'px, 0, 0)';
    });

    function endDrag(event) {
      if (drag === null || event.pointerId !== drag.id) return;
      var moved = drag.moved;
      drag = null;
      track.classList.remove('is-instant');

      if (moved <= -40) go(1);
      else if (moved >= 40) go(-1);
      else paint(true);

      // Cleared two frames later so the click that follows this pointerup still
      // sees the flag and gets swallowed.
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { viewport.dataset.vtDragged = 'false'; });
      });
    }

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);
    viewport.addEventListener('dragstart', function (event) { event.preventDefault(); });

    /* ---------- arrows + keyboard ---------- */

    if (prevBtn) prevBtn.addEventListener('click', function () { go(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { go(1); });

    viewport.addEventListener('keydown', function (event) {
      if (event.key === 'ArrowLeft') { event.preventDefault(); go(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); go(1); }
    });

    /* ---------- only run while on screen ---------- */

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          onScreen = entry.isIntersecting;
          if (onScreen) {
            settle();
          } else {
            var active = slides[pos];
            if (active) reset(active);
          }
        });
      }, { threshold: 0.3 });

      observer.observe(root);
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        var active = slides[pos];
        if (active) reset(active);
      } else {
        settle();
      }
    });

    /* ---------- layout ---------- */

    var raf = null;
    window.addEventListener('resize', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () { paint(false); });
    });

    paint(false);
    settle();

    if (document.readyState !== 'complete') {
      window.addEventListener('load', function () { paint(false); });
    }
  })();
</script>

