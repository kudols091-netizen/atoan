{%- liquid
  assign cols = section.blocks.size
  if cols > 4
    assign cols = 4
  endif
  if cols < 1
    assign cols = 1
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --hw-panel: {{ section.settings.panel_bg | default: '#c8ebc3' }};
    --hw-heading: {{ section.settings.heading_color | default: '#0f2410' }};
    --hw-text: {{ section.settings.text_color | default: '#0f2410' }};
    --hw-desc: {{ section.settings.desc_color | default: '#3a4a34' }};
    --hw-icon-color: {{ section.settings.icon_color | default: '#3f8a52' }};
    --hw-radius: {{ section.settings.panel_radius }}px;
    --hw-icon: {{ section.settings.icon_size }}px;
    --hw-title: {{ section.settings.title_size }}px;
    --hw-cols: {{ cols }};
    --hw-pad-top: {{ section.settings.padding_top }}px;
    --hw-pad-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hw {
    padding-top: calc(var(--hw-pad-top) * 0.7);
    padding-bottom: calc(var(--hw-pad-bottom) * 0.7);
  }

  .hw__inner {
    max-width: 1340px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .hw__panel {
    background: var(--hw-panel);
    border-radius: var(--hw-radius);
    padding: 32px 20px 36px;
  }

  .hw__heading {
    margin: 0 0 28px;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    color: var(--hw-heading);
  }

  .hw__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }

  .hw__step {
    text-align: center;
    padding: 0 10px;
  }

  .hw__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--hw-icon);
    margin: 0 auto 18px;
    color: var(--hw-icon-color);
  }

  .hw__icon svg {
    display: block;
    width: var(--hw-icon);
    height: var(--hw-icon);
  }

  .hw__icon img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: var(--hw-icon);
  }

  .hw__text {
    margin: 0;
    font-size: calc(var(--hw-title) * 0.85);
    font-weight: 700;
    line-height: 1.3;
    color: var(--hw-text);
  }

  .hw__desc {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--hw-desc);
  }

  .hw__desc > *:first-child { margin-top: 0; }
  .hw__desc > *:last-child { margin-bottom: 0; }

  @media screen and (min-width: 750px) {
    .hw {
      padding-top: var(--hw-pad-top);
      padding-bottom: var(--hw-pad-bottom);
    }

    .hw__panel { padding: 42px 30px 46px; }
    .hw__heading { font-size: 34px; margin-bottom: 34px; }

    /* Gap goes to zero so the divider rules sit flush between columns; the
       breathing room comes from the padding on each step instead. */
    .hw__grid {
      grid-template-columns: repeat(var(--hw-cols), minmax(0, 1fr));
      gap: 0;
    }

    .hw__step { padding: 0 24px; }
    .hw--dividers .hw__step + .hw__step { border-left: 1px solid rgba(0, 0, 0, 0.09); }
    .hw__text { font-size: var(--hw-title); }
  }
{%- endstyle -%}

<div class="hw{% if section.settings.show_dividers %} hw--dividers{% endif %}">
  <div class="hw__inner">
    <div class="hw__panel">
      {%- if section.settings.heading != blank -%}
        <h2 class="hw__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="hw__grid">
        {%- for block in section.blocks -%}
          <div class="hw__step" {{ block.shopify_attributes }}>
            <div class="hw__icon">
              {%- if block.settings.custom_icon != blank -%}
                {%- assign icon_alt = block.settings.custom_icon.alt | default: '' -%}
                {{
                  block.settings.custom_icon
                  | image_url: width: 280
                  | image_tag: loading: 'lazy', widths: '140, 200, 280', sizes: '140px', alt: icon_alt
                }}
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'photo' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <rect x="6" y="13" width="52" height="38" rx="5"/>
                      <path d="M6 42l13-13 9 9 7-7 16 15"/>
                      <circle cx="44" cy="24" r="6"/>
                      <path d="M41 20.5c2.4.6 4.3 2.5 4.9 4.9M40.6 24.7c1.6.6 2.9 1.9 3.5 3.5"/>
                      <g opacity="0.45">
                        <path d="M12 45.5l5-5M20 47.5l5-5M40 45l4-4M47 47l4-4"/>
                      </g>
                    </svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <rect x="10" y="27" width="44" height="26" rx="3"/>
                      <rect x="6" y="19" width="52" height="9" rx="2.5"/>
                      <path d="M32 19v34"/>
                      <path d="M32 19c-3-7-9-10.5-13-8.4-3.1 1.6-2.7 6 .9 7.4 3.4 1.3 8.7 1.2 12.1 1z"/>
                      <path d="M32 19c3-7 9-10.5 13-8.4 3.1 1.6 2.7 6-.9 7.4-3.4 1.3-8.7 1.2-12.1 1z"/>
                      <g opacity="0.45">
                        <path d="M16 33l5 5M16 42l5 5M43 33l5 5M43 42l5 5"/>
                      </g>
                    </svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="M32 52S8 38 8 23.5C8 16.6 13.6 11 20.5 11c4.6 0 8.7 2.5 11.5 6.3C34.8 13.5 38.9 11 43.5 11 50.4 11 56 16.6 56 23.5 56 38 32 52 32 52z"/>
                      <g opacity="0.45">
                        <path d="M17 21l6 6M17 30l9 9M27 19l6 6M38 21l6 6M36 32l7 7"/>
                      </g>
                    </svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="M5 17h31v25H5z"/>
                      <path d="M36 25h11l10 10v7H36z"/>
                      <circle cx="18" cy="47" r="5"/>
                      <circle cx="46" cy="47" r="5"/>
                      <path d="M5 42h8M23 42h13M51 42h6"/>
                      <g opacity="0.45">
                        <path d="M11 23l5 5M11 32l5 5M22 23l5 5M22 32l5 5"/>
                      </g>
                    </svg>
                  {%- when 'chat' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="M8 14h48v30H30L18 55V44H8z"/>
                      <path d="M20 25h24M20 33h16"/>
                    </svg>
                  {%- when 'globe' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <circle cx="32" cy="32" r="23"/>
                      <path d="M32 9c-6.5 6.5-10 14-10 23s3.5 16.5 10 23"/>
                      <path d="M32 9c6.5 6.5 10 14 10 23s-3.5 16.5-10 23"/>
                      <path d="M10.5 24h43M10.5 40h43"/>
                      <g opacity="0.4">
                        <path d="M18 18l4 4M18 26l4 4M42 34l4 4M42 42l4 4"/>
                      </g>
                    </svg>
                  {%- when 'doll' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <circle cx="25" cy="18" r="7.5"/>
                      <path d="M17.5 15c-.8-4.2 2.4-7.5 7.5-7.5s8.3 3.3 7.5 7.5"/>
                      <path d="M25 25.5v4"/>
                      <path d="M16 29.5h18l-2 17H18z"/>
                      <path d="M16.5 32l-6 6M33.5 32l6 6"/>
                      <path d="M22 46.5v8M28 46.5v8"/>
                      <circle cx="49" cy="17" r="8"/>
                      <path d="M45.5 17.2l2.6 2.6 4.6-5.2"/>
                      <g opacity="0.45">
                        <path d="M20 34l4 4M20 40l4 4M27 34l4 4M27 40l4 4"/>
                      </g>
                    </svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <circle cx="32" cy="22" r="9"/>
                      <path d="M16 24v-4.5C16 11 23.2 4.5 32 4.5S48 11 48 19.5V24"/>
                      <rect x="11.5" y="22" width="7" height="10" rx="3.5"/>
                      <rect x="45.5" y="22" width="7" height="10" rx="3.5"/>
                      <path d="M49 32v2.5a5.5 5.5 0 01-5.5 5.5H38"/>
                      <path d="M13 57c1.8-9.5 9.2-15 19-15s17.2 5.5 19 15"/>
                      <g opacity="0.45">
                        <path d="M19 51l5 5M27 48l5 5M35 48l5 5M43 51l5 5"/>
                      </g>
                    </svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="M32 6l21 7.5V30c0 13.5-8.8 23.3-21 29.5C19.8 53.3 11 43.5 11 30V13.5z"/>
                      <path d="M22.5 31.5l6.8 6.8L43 25"/>
                      <g opacity="0.4">
                        <path d="M16 21l4 4M16 29l4 4M16 37l4 4M44 21l4 4M44 29l4 4M44 37l4 4"/>
                      </g>
                    </svg>
                  {%- when 'smiley' -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <circle cx="32" cy="32" r="23"/>
                      <path d="M18 24l7 4.5-7 4.5"/>
                      <path d="M46 24l-7 4.5 7 4.5"/>
                      <path d="M21 39c3.5 6 18.5 6 22 0"/>
                      <g opacity="0.5">
                        <path d="M14.5 36l4 3M14.5 40.5l4 3M45.5 36l4 3M45.5 40.5l4 3"/>
                      </g>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <circle cx="27" cy="29" r="19"/>
                      <path d="M13.5 16c9 3.2 16.6 10.8 19.8 19.8"/>
                      <path d="M20.5 11.5c8.2 4 14.8 10.6 18.8 18.8"/>
                      <path d="M9 27.5c7 2.2 12.6 7.8 14.8 14.8"/>
                      <path d="M33 12.5c6 4 10.4 9.9 12.4 16.9"/>
                      <path d="M43 41c3 6.4 7.6 10.4 13.5 12.2"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>

            {%- if block.settings.text != blank -%}
              <p class="hw__text">{{ block.settings.text }}</p>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="hw__desc">{{ block.settings.description }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why choose us",
  "tag": "section",
  "class": "why-choose-us-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOW IT WORKS?"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Line between the steps",
      "info": "Desktop only. Steps stack on mobile, where a line would only add clutter.",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 56,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "info": "Mobile scales down from this automatically.",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel background",
      "default": "#c8ebc3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#0f2410"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title",
      "default": "#0f2410"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description",
      "default": "#3a4a34"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icons",
      "info": "Only affects the built-in icons, not an uploaded image.",
      "default": "#3f8a52"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "photo", "label": "Photo frame" },
            { "value": "yarn", "label": "Ball of yarn" },
            { "value": "gift", "label": "Gift box" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "globe", "label": "Globe" },
            { "value": "doll", "label": "Doll with tick" },
            { "value": "support", "label": "Support headset" },
            { "value": "shield", "label": "Shield with tick" },
            { "value": "smiley", "label": "Happy face" },
            { "value": "chat", "label": "Message" }
          ],
          "default": "yarn"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above. Use a PNG or SVG with a transparent background."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Title",
          "default": "Describe this step"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "info": "Optional. Leave empty for a title-only column."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "settings": {
        "heading": "HOW IT WORKS?",
        "show_dividers": true,
        "icon_size": 96,
        "title_size": 21
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "photo",
            "text": "Pick your size and upload your photo"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "yarn",
            "text": "Our makers crochet it by hand, stitch by stitch"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "gift",
            "text": "It ships to your door, ready to hug"
          }
        }
      ]
    },
    {
      "name": "Why choose us",
      "settings": {
        "heading": "Why choose us?",
        "show_dividers": false,
        "icon_size": 76,
        "title_size": 26
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "truck",
            "text": "Tracked Shipping",
            "description": "<p>Every order ships with tracking. We email you the number the moment it leaves us.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "doll",
            "text": "Made to Order",
            "description": "<p>Nothing is pre-made. We start your doll after you order it, in the size and colours you picked.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "chat",
            "text": "Talk to the Makers",
            "description": "<p>Your message reaches the people who crochet the dolls, not a script. We answer every one.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "shield",
            "text": "30-Day Returns",
            "description": "<p>Not what you hoped for? You have 30 days from delivery to start a return.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
