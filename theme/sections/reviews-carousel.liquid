{%- liquid
  assign autoplay_ms = section.settings.autoplay_speed | times: 1000

  assign summary_stars = 5
  if section.settings.rating_score != blank
    assign summary_stars = section.settings.rating_score | times: 1.0 | round
  endif
  if summary_stars > 5
    assign summary_stars = 5
  endif
  if summary_stars < 0
    assign summary_stars = 0
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --rv-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --rv-text: {{ section.settings.text_color | default: '#111111' }};
    --rv-card-bg: {{ section.settings.card_bg | default: '#f6f6f6' }};
    --rv-star: {{ section.settings.star_color | default: '#dd1f45' }};
    --rv-summary-star: {{ section.settings.summary_star_color | default: '#111111' }};
    --rv-card-radius: {{ section.settings.card_radius }}px;
    --rv-cols: {{ section.settings.columns_desktop | default: 4 }};
    --rv-gap: 20px;
    --rv-pad-top: {{ section.settings.padding_top }}px;
    --rv-pad-bottom: {{ section.settings.padding_bottom }}px;
  }

  .rv {
    background: var(--rv-bg);
    color: var(--rv-text);
    padding-top: calc(var(--rv-pad-top) * 0.7);
    padding-bottom: calc(var(--rv-pad-bottom) * 0.7);
    overflow-x: clip;
  }

  .rv__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .rv__heading {
    margin: 0 0 12px;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    color: inherit;
  }

  .rv__summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0 0 26px;
    font-size: 15px;
    line-height: 1;
    color: inherit;
  }

  .rv__summary-stars {
    display: inline-flex;
    gap: 2px;
    color: var(--rv-summary-star);
  }

  .rv__summary-stars svg { display: block; width: 17px; height: 17px; }
  .rv__summary-mark { color: var(--rv-summary-star); }

  /* ---------- carousel ---------- */

  .rv__carousel { position: relative; }

  .rv__viewport {
    overflow: hidden;
    --rv-per-view: 1;
  }

  .rv__viewport:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .rv__track {
    display: flex;
    gap: var(--rv-gap);
    align-items: stretch;
    transition: transform 450ms cubic-bezier(0.4, 0, 0.2, 1);
    touch-action: pan-y;
    will-change: transform;
  }

  .rv__track.is-instant { transition: none; }

  .rv__slide {
    flex: 0 0 calc((100% - (var(--rv-per-view) - 1) * var(--rv-gap)) / var(--rv-per-view));
    min-width: 0;
  }

  .rv--static .rv__slide[data-rv-clone] { display: none; }

  .rv__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: none;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-top: -15px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .rv__nav svg { display: block; width: 22px; height: 22px; }
  .rv__nav:hover { opacity: 0.6; }
  .rv__nav:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .rv__nav--prev { left: 0; }
  .rv__nav--next { right: 0; }
  .rv--static .rv__nav { display: none; }

  /* ---------- card ---------- */

  .rv__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--rv-card-radius);
    background: var(--rv-card-bg);
  }

  .rv__media {
    aspect-ratio: 1 / 1;
    background: #eeeae6;
  }

  .rv__media img,
  .rv__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rv__body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 16px 22px;
    text-align: center;
  }

  .rv__quote-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(4 * 1.45em);
    margin-bottom: 14px;
    font-size: 15px;
    line-height: 1.45;
  }

  .rv__quote {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .rv__stars {
    display: inline-flex;
    gap: 3px;
    margin-bottom: 12px;
    color: var(--rv-star);
  }

  .rv__stars svg { display: block; width: 22px; height: 22px; }

  .rv__author {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  .rv__author-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rv__verified { flex: none; width: 15px; height: 15px; }

  .rv__product {
    max-width: 100%;
    margin-top: 10px;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.3;
    color: #8a8a8a;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- breakpoints ---------- */

  @media screen and (min-width: 750px) {
    .rv__viewport { --rv-per-view: 2; }
  }

  @media screen and (min-width: 990px) {
    .rv {
      padding-top: var(--rv-pad-top);
      padding-bottom: var(--rv-pad-bottom);
    }

    .rv__viewport { --rv-per-view: var(--rv-cols); }
    .rv__carousel { padding: 0 44px; }
    .rv__nav { display: flex; }
    .rv__heading { font-size: 34px; margin-bottom: 14px; }
    .rv__summary { margin-bottom: 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv__track { transition: none; }
  }
{%- endstyle -%}

<div
  class="rv"
  id="RvCarousel-{{ section.id }}"
  data-rv-root
  data-rv-autoplay="{{ section.settings.autoplay }}"
  data-rv-speed="{{ autoplay_ms }}"
>
  <div class="rv__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="rv__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.show_summary -%}
      <div class="rv__summary">
        <span class="rv__summary-stars" role="img" aria-label="{{ section.settings.rating_score | escape }} out of 5 stars">
          {%- for s in (1..5) -%}
            {%- if s <= summary_stars -%}
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7l-4.4-4 5.9-.7z"/>
              </svg>
            {%- else -%}
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7l-4.4-4 5.9-.7z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
          {%- endfor -%}
        </span>

        {%- if section.settings.rating_score != blank -%}
          <span>{{ section.settings.rating_score }}</span>
          <span class="rv__summary-mark" aria-hidden="true">&#9733;</span>
        {%- endif -%}

        {%- if section.settings.rating_count != blank -%}
          <span>({{ section.settings.rating_count }})</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="rv__carousel">
      <div
        class="rv__viewport"
        data-rv-viewport
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label="{{ 'Customer reviews' | escape }}"
      >
        <div class="rv__track" data-rv-track>
          {%- for block in section.blocks -%}
            <div class="rv__slide" data-rv-slide {{ block.shopify_attributes }}>
              <div class="rv__card">
                <div class="rv__media">
                  {%- if block.settings.image != blank -%}
                    {%- assign review_alt = block.settings.image.alt -%}
                    {%- if review_alt == blank -%}
                      {%- assign review_alt = 'Photo sent in by a customer' -%}
                    {%- endif -%}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 300, 400, 600, 800',
                        sizes: '(min-width: 990px) calc(1112px / 4), (min-width: 750px) 45vw, calc(100vw - 40px)',
                        alt: review_alt
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>

                <div class="rv__body">
                  {%- if block.settings.quote != blank -%}
                    <div class="rv__quote-wrap">
                      <p class="rv__quote">{{ block.settings.quote }}</p>
                    </div>
                  {%- endif -%}

                  <span class="rv__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {%- for s in (1..5) -%}
                      {%- if s <= block.settings.rating -%}
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                          <path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7l-4.4-4 5.9-.7z"/>
                        </svg>
                      {%- else -%}
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                          <path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7l-4.4-4 5.9-.7z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                        </svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>

                  {%- if block.settings.author != blank -%}
                    <span class="rv__author">
                      <span class="rv__author-name">{{ block.settings.author }}</span>
                      {%- if block.settings.verified -%}
                        <svg class="rv__verified" viewBox="0 0 16 16" aria-label="{{ 'Verified buyer' | escape }}" role="img">
                          <circle cx="8" cy="8" r="8" fill="currentColor"/>
                          <path d="M4.5 8.2l2.3 2.3 4.7-4.7" fill="none" stroke="#ffffff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {%- endif -%}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.product_name != blank -%}
                    <span class="rv__product">{{ block.settings.product_name }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <button
        type="button"
        class="rv__nav rv__nav--prev"
        data-rv-prev
        aria-label="{{ 'Show the previous reviews' | escape }}"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M15 4l-8 8 8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="rv__nav rv__nav--next"
        data-rv-next
        aria-label="{{ 'Show the next reviews' | escape }}"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('RvCarousel-{{ section.id }}');
    if (!root || root.dataset.rvInit === 'true') return;
    root.dataset.rvInit = 'true';

    var viewport = root.querySelector('[data-rv-viewport]');
    var track = root.querySelector('[data-rv-track]');
    var prevBtn = root.querySelector('[data-rv-prev]');
    var nextBtn = root.querySelector('[data-rv-next]');
    if (!viewport || !track) return;

    var real = Array.prototype.slice.call(track.querySelectorAll('[data-rv-slide]'));
    var total = real.length;
    if (total === 0) return;

    // Clone a fixed run at both ends so there is always a full screen of cards
    // on either side. Five is the largest "cards per view" the schema allows.
    var MAX_PER_VIEW = 5;
    var clones = Math.min(MAX_PER_VIEW, total);

    for (var i = 0; i < clones; i++) {
      var tail = real[total - 1 - i].cloneNode(true);
      tail.setAttribute('data-rv-clone', '');
      tail.setAttribute('aria-hidden', 'true');
      tail.removeAttribute('id');
      track.insertBefore(tail, track.firstChild);

      var head = real[i].cloneNode(true);
      head.setAttribute('data-rv-clone', '');
      head.setAttribute('aria-hidden', 'true');
      head.removeAttribute('id');
      track.appendChild(head);
    }

    var pos = clones;
    var perView = 1;
    var enabled = false;
    var timer = null;
    var drag = null;
    var speed = parseInt(root.dataset.rvSpeed, 10) || 3000;
    var wantsAutoplay = root.dataset.rvAutoplay === 'true';
    var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    function readPerView() {
      var raw = parseInt(getComputedStyle(viewport).getPropertyValue('--rv-per-view'), 10);
      return raw > 0 ? raw : 1;
    }

    // Distance between two adjacent slides = slide width + gap. Reading it from
    // the DOM keeps this correct whatever the breakpoint or container width.
    // Skip zero-width children: clones are display:none while the section is
    // showing every review at once, and measuring one would give a bogus step.
    function step() {
      var kids = track.children;
      var first = null;
      for (var k = 0; k < kids.length; k++) {
        var box = kids[k].getBoundingClientRect();
        if (box.width === 0) continue;
        if (first === null) { first = box; continue; }
        return box.left - first.left;
      }
      return first === null ? 0 : first.width;
    }

    function apply(animate) {
      if (!animate) track.classList.add('is-instant');
      track.style.transform = 'translate3d(' + -(pos * step()) + 'px, 0, 0)';
      if (!animate) {
        void track.offsetWidth;
        track.classList.remove('is-instant');
      }
    }

    function go(delta) {
      if (!enabled) return;
      pos += delta;
      apply(true);
    }

    track.addEventListener('transitionend', function (event) {
      if (event.target !== track || event.propertyName !== 'transform') return;
      if (pos >= total + clones) {
        pos -= total;
        apply(false);
      } else if (pos < clones) {
        pos += total;
        apply(false);
      }
    });

    /* ---------- autoplay ---------- */

    // Every reason to hold autoplay is tracked as its own flag. Toggling a
    // single "paused" boolean would let one reason clear another: moving focus
    // out of the section while the pointer is still hovering it, say.
    var held = { hover: false, focus: false, drag: false };

    function stopAuto() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function syncAuto() {
      var blocked = !enabled || !wantsAutoplay || motionQuery.matches ||
        document.hidden || held.hover || held.focus || held.drag;

      if (blocked) {
        stopAuto();
        return;
      }

      if (!timer) timer = setInterval(function () { go(1); }, speed);
    }

    function hold(key, value) {
      held[key] = value;
      syncAuto();
    }

    root.addEventListener('pointerenter', function () { hold('hover', true); });
    root.addEventListener('pointerleave', function () { hold('hover', false); });
    root.addEventListener('focusin', function () { hold('focus', true); });
    root.addEventListener('focusout', function (event) {
      if (root.contains(event.relatedTarget)) return;
      hold('focus', false);
    });

    document.addEventListener('visibilitychange', syncAuto);

    if (motionQuery.addEventListener) {
      motionQuery.addEventListener('change', syncAuto);
    }

    /* ---------- drag / swipe ---------- */

    viewport.addEventListener('pointerdown', function (event) {
      if (!enabled) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;

      var span = step();
      drag = { id: event.pointerId, x: event.clientX, moved: 0, base: pos * span, limit: span * 0.9 };
      track.classList.add('is-instant');
      hold('drag', true);
      try { viewport.setPointerCapture(event.pointerId); } catch (e) {}
    });

    viewport.addEventListener('pointermove', function (event) {
      if (drag === null || event.pointerId !== drag.id) return;

      // Cap the follow at just under one card. A gesture only ever advances one
      // review, so letting the track run further would just expose empty space.
      var moved = event.clientX - drag.x;
      if (moved > drag.limit) moved = drag.limit;
      if (moved < -drag.limit) moved = -drag.limit;

      drag.moved = moved;
      track.style.transform = 'translate3d(' + -(drag.base - moved) + 'px, 0, 0)';
    });

    function endDrag(event) {
      if (drag === null || event.pointerId !== drag.id) return;
      var moved = drag.moved;
      drag = null;
      track.classList.remove('is-instant');

      if (moved <= -40) pos += 1;
      else if (moved >= 40) pos -= 1;

      apply(true);
      hold('drag', false);
    }

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    /* ---------- arrows + keyboard ---------- */

    if (prevBtn) prevBtn.addEventListener('click', function () { go(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { go(1); });

    viewport.addEventListener('keydown', function (event) {
      if (event.key === 'ArrowLeft') { event.preventDefault(); go(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); go(1); }
    });

    /* ---------- layout ---------- */

    function refresh(force) {
      var next = readPerView();
      var changed = next !== perView;
      perView = next;
      enabled = total > perView;
      root.classList.toggle('rv--static', !enabled);

      if (!enabled) {
        pos = 0;
        track.style.transform = 'translate3d(0, 0, 0)';
        syncAuto();
        return;
      }

      if (changed || force) pos = clones;
      apply(false);
      syncAuto();
    }

    var raf = null;
    window.addEventListener('resize', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () { refresh(false); });
    });

    refresh(true);
    if (document.readyState !== 'complete') {
      window.addEventListener('load', function () { refresh(false); });
    }
  })();
</script>

{% schema %}
{
  "name": "Reviews Carousel",
  "tag": "section",
  "class": "rv-section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Customers Say It Best!"
    },
    {
      "type": "header",
      "content": "Rating summary"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show the rating summary line",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Average score",
      "info": "Shown as typed. The filled stars follow this number.",
      "default": "4.92"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Number of reviews",
      "default": "371"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Cards per view on desktop",
      "info": "Tablet always shows 2, mobile always shows 1.",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Advance automatically",
      "info": "Pauses on hover, on keyboard focus, while dragging, and when the browser tab is hidden.",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds between reviews",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f6f6f6"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars on cards",
      "default": "#dd1f45"
    },
    {
      "type": "color",
      "id": "summary_star_color",
      "label": "Stars in the summary line",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review",
          "info": "Trimmed to 4 lines on the card.",
          "default": "I bought two of these crochet rabbits for gifts and they are absolutely beautiful."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Sharon Q."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show the verified badge",
          "default": true
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product bought",
          "default": "Handmade Crochet Bunny"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Carousel",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
